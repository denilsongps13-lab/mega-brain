# ==============================================================================
# Mega Brain - Configuracao de ambiente
# ==============================================================================
# Copie este arquivo para .env e preencha somente as chaves que voce for usar.
# O arquivo .env e local, esta no .gitignore e nunca deve ser versionado.
# ==============================================================================

# Provedor padrao do pipeline. Valores aceitos:
# gemini | groq | anthropic | openai
MCE_LLM_PROVIDER=gemini

# Fallback usado quando o provedor padrao falha de forma transitoria.
MCE_LLM_FALLBACK_PROVIDER=groq

# Google Gemini
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq (fallback padrao)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (embeddings, transcricao e opcionalmente LLM)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Embeddings alternativos
# VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Voz / transcricao opcionais
# ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Overrides opcionais de modelo
# MCE_LLM_GROQ_MODEL=openai/gpt-oss-120b
# MCE_LLM_OPENAI_MODEL=gpt-4o-mini
# MCE_LLM_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GROQ_BASE_URL=https://api.groq.com/openai/v1
