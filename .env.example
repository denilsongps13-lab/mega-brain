# Mega Brain environment
# Copy to .env only for manual setups. The Windows installer creates .env for you.
# Never commit real keys.

# Required for the default Claude Code gateway route.
GEMINI_API_KEY=

# Optional but recommended: automatic fallback when Gemini returns errors such as 429/503.
GROQ_API_KEY=

# Optional model overrides. Leave blank to use launcher defaults.
# Default primary: gemini/gemini-2.5-flash
# Default fallback: groq/openai/gpt-oss-120b
MEGA_BRAIN_PRIMARY_MODEL=
MEGA_BRAIN_FALLBACK_MODEL=

# Optional direct Anthropic access for components that explicitly use Anthropic.
ANTHROPIC_API_KEY=

# Optional providers used by other Mega Brain features.
OPENAI_API_KEY=
GOOGLE_API_KEY=
VOYAGE_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
YOUTUBE_API_KEY=
PINECONE_API_KEY=
HUGGINGFACE_TOKEN=
